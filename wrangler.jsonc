{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edging-mail",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mail.duongnamtruong.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // `wrangler dev` only: without this the Worker is told its URL is the `routes` hostname (inferred from `routes`),
  // which makes the WebSocket Origin check refuse the Vite dev server (http://localhost:<port>).
  "dev": { "host": "localhost" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // An unknown path is a plain 404, never the app shell (no soft-404 copies of the app for search engines).
    // The app shell itself is served by the Worker at /app (src/worker/site/).
    "not_found_handling": "none",
    // The Worker answers these paths before the static files: the public site (src/worker/site/) and the API. "/" has to be
    // listed because index.html is a real asset that would otherwise be served for it. A plain entry matches that path
    // only, so it does not swallow /sw.js, /assets/* and the other static files; "/app/*" matches everything below /app.
    "run_worker_first": ["/api/*", "/", "/en", "/en/", "/zh", "/zh/", "/app", "/app/*", "/robots.txt", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edging_mail_db",
      "database_id": "1676eb5f-62e8-41cf-bb5f-555e8fdf3504",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "edging-mail-storage"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "MAIL_HUB", "class_name": "MailHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MailHub"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_NAME": "Edging Mail",
    "DEFAULT_FROM": "hi@duongnamtruong.com",
    // "on" serves the public landing page at /, /en/ and /zh/ (and robots.txt + sitemap.xml). Anything else, or unset, turns it off:
    // / then goes straight to /app. A fork leaves it unset unless it wants a public page.
    "LANDING_PAGE": "on"
  }
}
