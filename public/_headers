# Cloudflare Workers Assets header rules (served with dist/client).
# A new deploy must reach the browser at once, so these two are always revalidated.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Vite emits content-hashed file names here, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for every static file. The mail frame is a srcdoc document and inherits this policy, so img-src allows
# https: here and the frame's own meta policy (MailFrame.tsx) is what blocks remote images until 'Show images'.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss:; frame-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
