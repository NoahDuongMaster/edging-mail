  "conventions": {
    "text_fields": "Every AAD/info field that is text (address, row_id, key_id, org_key_id, purpose) is its UTF-8 bytes; fields are joined with a single 0x00 byte; no length prefixes.",
    "key_id": "base64url(SHA-256(SPKI DER)[0:16]) without padding. AAD and DB columns use this text form; blob headers carry the raw 16 bytes and the reader MUST check header == column.",
    "address": "ASCII primary address, trimmed and lower-cased, exactly as stored; never an alias, never changed after account creation.",
    "auth_on_the_wire": "base64url without padding of the 32 raw bytes; the server decodes it (reject non-canonical) and feeds the RAW 32 bytes to the verifier PBKDF2.",
    "blob_layout": "AES-GCM blobs = 0x01 || iv(12) || ciphertext || tag(16). HPKE wrapped_cek = 0x01 || suite 0x01 || key_id raw(16) || enc(65) || ciphertext(48) = 131 bytes.",
    "pkcs8_note": "PKCS8 bytes differ between implementations (Chrome/workerd/OpenSSL); never compare PKCS8 bytes across runtimes, compare the derived public key / key_id."
  },
